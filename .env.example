# These are plain environment variables; the app does not load .env files itself.
# Export them in your shell (e.g. `set -a; . ./.env; set +a`). Never commit real secrets.
# ANTHROPIC_API_KEY is read by the Anthropic SDK from the environment and never stored in code.
# RAG_LLM_MODEL has no default: set it to the Claude model id you want to use.
RAG_LLM_MODEL=
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
# PROVISIONAL retrieval gate, NOT yet calibrated for the real embedding model.
# Scores are model-specific: run scripts/calibrate.py once the model can be downloaded.
RAG_MIN_SCORE=0.45
RAG_MAX_FILE_MB=20
